# Copy to .env and adjust. .env is git-ignored — never commit real values.
#
# These are read by Ansible, not by the shell. Any of them can also be passed
# directly: ansible-playbook site.yml -e caddy_base=/srv/caddy

# Where the proxy keeps its configuration, certificates and runtime state.
CADDY_BASE=/opt/caddy

# Let's Encrypt account address. Also used for expiry notices.
CADDY_ACME_EMAIL=you@example.com

# Pinned on purpose: a floating tag makes a deploy unreproducible.
CADDY_IMAGE=caddy:2.8-alpine

# TLS is NOT set here. It belongs to each route snippet: omit `tls` for a
# Let's Encrypt certificate, or write `tls internal` in the snippet for a
# self-signed one. That way a project without a domain can sit next to one
# that has it.