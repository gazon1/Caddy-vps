# Generated by the Caddy-vps wbparser role — do not edit by hand.
#
# The container's own environment, passed through compose `env_file`. Values here
# are literal: nothing in this file is interpolated, which is exactly why the
# credentials live here and the image digest lives in .env.
#
# DB_* are read by BOTH spring.datasource (health endpoints) and crawler.database
# (the crawler itself) — application.yml binds them from the same placeholders, so
# the health check and the crawler cannot end up pointed at different databases.

# --- Database ---
DB_HOST={{ wbparser_db_host }}
DB_PORT={{ wbparser_db_port }}
DB_NAME={{ wbparser_db_name }}
DB_USER={{ wbparser_db_user }}
DB_PASSWORD={{ _wbparser_db_password }}

# --- Application ---
# `worker` turns the cron scheduler on; `admin` and `public` leave it off.
SPRING_PROFILES_ACTIVE={{ wbparser_profile }}

# On: the production database has been migrated by the application itself and
# its Flyway history matches the migrations in the application repository, so
# a deploy now applies a new migration instead of refusing to start. See
# wbparser_flyway_enabled in the role defaults for what to do when a
# migration cannot be applied that way.
SPRING_FLYWAY_ENABLED={{ wbparser_flyway_enabled }}

# The admin API. An empty ADMIN_PASSWORD would leave /api/admin/** reachable with
# a credential nobody chose, which is why the role refuses to deploy without one.
ADMIN_PASSWORD={{ _wbparser_admin_password }}

# The X-Api-Key for the admin endpoints. Optional: the application falls back to a
# well-known development key, which is why setting it is worth the effort.
{% if _wbparser_admin_api_key | length > 0 %}
ADMIN_API_KEY={{ _wbparser_admin_api_key }}
{% endif %}

# The key the crawler authenticates against the AdsPower Local API with. It is
# the same credential the browser runtime starts the API with, which is why it
# comes from one source — the `adsbrowser_api_key` the playbook resolves from
# -e, from WBPARSER_ADMIN_API_KEY, or from the vault. It lives here, in a file
# compose passes literally, and not in .env, which compose interpolates.
ADSPOWER_API_KEY={{ _wbparser_adsbrowser_api_key }}

# Where the AdsPower Local API is. The browser runtime shares the crawler's network
# namespace, so its API is on the crawler's own loopback — not on the host's
# address, and not on a published port. Naming it saves the crawler a discovery
# probe on every start, and it says what the arrangement is: the API is reachable
# only from inside this namespace.
ADSPOWER_API_BASE=http://127.0.0.1:50325
