# Generated by the Caddy-vps wbparser role — do not edit by hand.
#
# Image coordinates only. Compose interpolates ${…} out of THIS file, so nothing
# secret belongs here: a `$` in a value would be expanded. Credentials live in
# app.env and browser.env, which reach the containers through env_file and are
# passed literally.
#
# DIGEST and BROWSER_DIGEST, not tags: a tag can be moved to a different
# image, a digest names one set of bytes. The storefront that reads the
# catalog API pins the crawler by digest, so the deploy has to name the same
# bytes it was checked against. The browser runtime is pinned for the same
# reason: a crawler that talks to a different browser than the one it was
# checked against is not the deployment anybody tested.
# The value is sha256:<64 hex characters>, as the registry reports it.
DIGEST={{ wbparser_env_digest }}
BROWSER_DIGEST={{ wbparser_env_browser_digest | default(wbparser_browser_digest) }}
IMAGE_OWNER={{ wbparser_image_owner }}
