# Environment for adsbrowser / adspower-browser CLI
# Installed by Ansible adsbrowser role — do not edit by hand.
# {{ ansible_date_time.iso8601 }}

ADSPOWER_ENDPOINT={{ adsbrowser_endpoint }}
ADSPOWER_API_KEY={{ adsbrowser_api_key }}
ADSPOWER_API_PORT={{ adsbrowser_api_port }}

# Headless X11 (Xvfb on :99, started by this role)
DISPLAY=:99

# Logging
ADSPOWER_LOG_DIR={{ adsbrowser_log_dir }}
