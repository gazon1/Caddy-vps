# Environment for wb-parser
# Managed by Ansible - DO NOT EDIT MANUALLY

# --- Database (shared DB host) ---
DB_HOST={{ db_host | default('91.188.212.209') }}
DB_PORT={{ db_port | default(5432) }}
DB_NAME={{ db_name | default('wbparser') }}
DB_USER={{ db_user | default('postgres') }}
DB_PASSWORD={{ db_password | default('changeme') }}

# --- Admin API (REQUIRED - generate with: openssl rand -base64 32) ---
ADMIN_API_KEY={{ admin_api_key | default('') }}
ADMIN_USER={{ admin_user | default('admin') }}
ADMIN_PASSWORD={{ admin_password | default('') }}

# --- Optional ---
OTEL_ENDPOINT={{ otel_endpoint | default('') }}
